{
  "name": "db-migrate",
  "version": "3.0.1",
  "description": "Multi-database migration management (MongoDB & MariaDB/MySQL) with validation and testing",
  "main": "src/cli.js",
  "type": "module",
  "bin": {
    "db-migrate": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js --help",
    "status": "node src/cli.js status",
    "up": "node src/cli.js up",
    "down": "node src/cli.js down",
    "validate": "node src/cli.js validate",
    "test:migration": "node src/cli.js test",
    "test:all": "node src/cli.js test-all",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "lint": "eslint . --max-warnings 0",
    "docker:up": "docker compose up -d mongodb mariadb",
    "docker:down": "docker compose down",
    "docker:test": "docker compose run --rm test-all",
    "docker:build": "docker build -t db-migrate:3.0.1 .",
    "run:tests": "bash scripts/run-tests.sh"
  },
  "keywords": [
    "mongodb",
    "mariadb",
    "mysql",
    "migration",
    "ddl",
    "dcl",
    "database",
    "kubernetes",
    "helm"
  ],
  "author": "i7ppBeer",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.0",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^6.10.0",
    "mysql2": "^3.24.5",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.15.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
