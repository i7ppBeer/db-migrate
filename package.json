  "description": "MongoDB DDL migration management with validation and automated testing",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "init": "node src/cli.js init",
    "create": "node src/cli.js create",
    "validate": "node src/cli.js validate",
    "test:local": "node src/cli.js test-local",
