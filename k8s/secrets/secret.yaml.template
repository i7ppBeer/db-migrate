# Kubernetes Secret Template
# DO NOT commit actual secrets to git!
# Use kubectl create secret or sealed-secrets in production

apiVersion: v1
kind: Secret
metadata:
  name: mongodb-credentials
  namespace: mongodb-migrations
type: Opaque
stringData:
  # Replace with actual values or use external secret management
  MONGODB_URL: "mongodb://admin:CHANGE_ME@mongodb-service:27017"
  # Alternative: use base64 encoded data
  # data:
  #   MONGODB_URL: bW9uZ29kYjovL2FkbWluOkNIQU5HRV9NRUBtb25nb2RiLXNlcnZpY2U6MjcwMTc=
