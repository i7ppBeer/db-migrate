# KEY=VALUE, no quotes, no inline comments. Any key can be overridden from the environment.
PROJECT=shop
DB=mariadb
NAMESPACE=db-migrate
ENVIRONMENT=staging
# Secrets with keys "username" and "password" — DDL and DCL use different DB accounts
DDL_SECRET=db-migrate-shop-mariadb-ddl
DCL_SECRET=db-migrate-shop-mariadb-dcl
# Relative to this directory
DDL_DIR=migrations/ddl
DCL_DIR=migrations/dcl
