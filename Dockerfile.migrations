# ============================================================
# Production Migration Image Dockerfile
# 用於 CI/CD 建置包含遷移檔案的 Image
# ============================================================
#
# 使用方式:
#   docker build -f Dockerfile.migrations \
#     --build-arg MIGRATIONS_PATH=./your-migrations \
#     -t your-registry/db-migrate:v1.0.0 .
#
# ============================================================

# 使用 db-migrate 基礎映像
ARG BASE_IMAGE=db-migrate:2.0.0
FROM ${BASE_IMAGE} AS base

# ============================================================
# Production Migration Runner
# ============================================================
FROM base

# Build arguments
ARG MIGRATIONS_PATH=./migrations
ARG BUILD_DATE
ARG BUILD_VERSION
ARG GIT_COMMIT

# Labels
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.title="DB Migration Runner" \
      org.opencontainers.image.description="Database migration runner with bundled migrations"

WORKDIR /app

# ✅ 核心：複製遷移檔案到映像中
COPY ${MIGRATIONS_PATH}/ /app/migrations/

# 設定遷移目錄環境變數
ENV MIGRATIONS_DIR=/app/migrations

# 列出已包含的遷移檔案（建置時顯示）
RUN echo "=== Bundled Migrations ===" && \
    ls -la /app/migrations/ && \
    echo "=========================="

# 使用 entrypoint
ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["up"]
